{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "/Users/yansongda/200-HarmonyOS/HarmonyOS-证书.cer",
          "keyAlias": "HarmonyOS",
          "keyPassword": "000000181F0BAB2DAAE4C7D24626225A06B841C658BE0F0572C8CE6577D10873FAD1BAFF12CE5B1C",
          "profile": "/Users/yansongda/200-HarmonyOS/元服务-MFA-Release.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/Users/yansongda/200-HarmonyOS/HarmonyOS-秘钥.p12",
          "storePassword": "00000018F68210DD1C4DF10622DF81872B4BA8DCE8FF368D3AE77B793713FBBDE59425B79742C9F3"
        }
      },
      {
        "name": "debug",
        "type": "HarmonyOS",
        "material": {
          "certpath": "/Users/yansongda/200-HarmonyOS/HarmonyOS-证书-Debug.cer",
          "keyAlias": "HarmonyOS-Debug",
          "keyPassword": "000000180F27B209097B52FD2909F7601CE7F8AEA44263B0256BBBE322F92C7F6AE80AF53DBCEC3F",
          "profile": "/Users/yansongda/200-HarmonyOS/元服务-MFA-Debug.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/Users/yansongda/200-HarmonyOS/HarmonyOS-秘钥.p12",
          "storePassword": "00000018BEB4CB919442626456BD32D9992005B83D369D1501253FEC3E14E891886FA8AE198849CA",
        }
      }
    ],
    // 约定：products 之间只允许 signingConfig 不同（bundleName 由 app.json5 统一提供，且必须与证书 Profile 一致）
    "products": [
      {
        // 正式包：release 证书。hvigor 要求必须存在 name 为 default 的 product
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        // 本地调试包：debug 证书（含设备 UDID 白名单），与 default 仅签名不同
        "name": "debug",
        "signingConfig": "debug",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    // 环境地址由构建模式在编译期注入（见 entry/src/main/ets/App.ets 的 App.env）
    // 优先级：模块 target > 模块 buildOptionSet > 模块 buildOption > product > buildModeSet
    // 注意：新增自定义 buildMode 时必须同时配置 ENV，否则生成的 BuildProfile 里没有 ENV，编译会失败
    "buildModeSet": [
      {
        "name": "debug",
        "buildOption": {
          "arkOptions": {
            "buildProfileFields": {
              "ENV": "test"
            }
          }
        }
      },
      {
        "name": "release",
        "buildOption": {
          "arkOptions": {
            "buildProfileFields": {
              "ENV": "prod"
            }
          }
        }
      },
      {
        // ohosTest 测试套运行时会自动使用 test 构建模式，缺失该条目会导致 ENV 未定义
        "name": "test",
        "buildOption": {
          "arkOptions": {
            "buildProfileFields": {
              "ENV": "test"
            }
          }
        }
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "debug"
          ]
        }
      ]
    }
  ]
}