<view class="item">
  <t-swipe-cell>
    <view class="item-body" bind:tap="detail">
      <view class="item-body-info">
        <view class="item-body-info-issuer">{{ issuer }}</view>
        <view class="item-body-info-username">{{ username }}</view>
      </view>
      <view class="item-body-code {{ digits >= 8 ? 'code-8' : digits === 7 ? 'code-7' : '' }}" catch:tap="copy">{{ code }}</view>
    </view>
    <view slot="right" class="item-btn">
      <view class="btn btn-pin" bind:tap="pin">
        {{ pinned ? '取消置顶' : '置顶' }}
      </view>
      <view class="btn btn-delete" bind:tap="delete">
        删除
      </view>
    </view>
  </t-swipe-cell>
  <view class="item-tags" wx:if="{{tags.length > 0 || pinned}}">
    <view class="item-tag" wx:if="{{tags.length > 0}}">#{{ tags[0] }}</view>
    <view class="item-pin" wx:if="{{pinned}}">置顶</view>
  </view>
  <progress class="item-progress" percent="{{ remainSeconds / period * 100 }}" stroke-width="2" active-color="#5bb43b" background-color="#e8e8e8" />
</view>
