<app-lock-screen wx:if="{{locked}}" bind:unlocked="onUnlocked" />
<t-toast id="t-toast" />
<t-message id="t-message" />

<view class="page">
  <view wx:if="{{mode === 'import'}}" class="section-hint import-mode-hint">
    导入加密备份：粘贴备份文本或选择 .mfa 文件
  </view>

  <view class="section" wx:if="{{mode !== 'import'}}">
    <view class="section-label">导出加密备份</view>
    <view class="card">
      <view class="card-desc">当前共 {{itemsCount}} 个账号，单次最多导出 {{maxItems}} 条。备份由服务端加密，忘记口令将无法恢复。</view>
      <t-input
        type="safe-password"
        label="口令"
        placeholder="至少 8 个字符"
        value="{{exportPassword}}"
        maxlength="128"
        align="left"
        borderless
        bind:change="onExportPasswordChange"
      />
      <t-input
        type="safe-password"
        label="确认口令"
        placeholder="再次输入口令"
        value="{{exportPasswordConfirm}}"
        maxlength="128"
        align="left"
        borderless
        bind:change="onExportPasswordConfirmChange"
      />
      <view class="actions">
        <t-button theme="primary" block bind:tap="onExport">生成加密备份</t-button>
        <t-button wx:if="{{exportReady}}" variant="outline" block bind:tap="onSaveFile">保存并发送文件</t-button>
        <t-button wx:if="{{exportReady}}" variant="outline" block disabled="{{!exportClipboardAllowed}}" bind:tap="onCopyExport">复制到剪贴板</t-button>
      </view>
      <view wx:if="{{exportReady}}" class="card-desc">{{exportMeta}}</view>
      <view wx:if="{{exportReady && !exportClipboardAllowed}}" class="card-desc warn">备份较大，剪贴板通道不可用，请使用文件通道</view>
      <view class="card-desc">备份文件只有密文；发送或复制后请注意清理聊天记录与剪贴板。</view>
    </view>
  </view>

  <view class="section">
    <view class="section-label">导入备份</view>
    <view class="card">
      <view class="card-desc">从备份文件或剪贴板导入，自动识别内容（不看后缀）。重复导入会新增重复条目。</view>
      <view class="actions">
        <t-button variant="outline" block bind:tap="onPasteImport">从剪贴板粘贴</t-button>
        <t-button variant="outline" block bind:tap="onChooseFile">从聊天选择文件</t-button>
      </view>

      <view wx:if="{{importReady}}" class="import-meta">{{importMeta}}</view>

      <t-input
        wx:if="{{importReady}}"
        type="safe-password"
        label="口令"
        placeholder="输入备份口令"
        value="{{importPassword}}"
        maxlength="128"
        align="left"
        borderless
        bind:change="onImportPasswordChange"
      />

      <view class="actions" wx:if="{{importReady}}">
        <t-button theme="primary" block bind:tap="onStartImport">导入 {{importCount}} 条</t-button>
      </view>

      <view wx:if="{{summary}}" class="card-desc">{{summary}}</view>
    </view>
  </view>
</view>
