name = "application-rs"

[bin-api]
listen = "0.0.0.0"
port = 8080
debug = false

[databases.account]
url = "mysql://root:root@127.0.0.1:3306/account"
max-connections = 20
min-connections = 2
acquire-timeout = 3
idle-timeout = 300

[databases.tool]
url = "mysql://root:root@127.0.0.1:3306/tool"
min-connections = 2
max-connections = 20
idle-timeout = 300
acquire-timeout = 3

[short-url]
domain = "https://u.ysdor.cn"

[http]
connect-timeout-secs = 1
timeout-secs = 3

