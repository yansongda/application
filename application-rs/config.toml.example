name = "application-rs"

[bin-api]
listen = "0.0.0.0"
port = 8080
debug = false

[databases.account]
url = "mysql://root:root@127.0.0.1:3306/account"
max-connections = 20
min-connections = 2
acquire-timeout = 3
idle-timeout = 300

[databases.tool]
url = "mysql://root:root@127.0.0.1:3306/tool"
min-connections = 2
max-connections = 20
idle-timeout = 300
acquire-timeout = 3

[short-url]
domain = "https://u.ysdor.cn"

[http]
connect-timeout-secs = 1
timeout-secs = 3
# 连接池空闲连接保活时长（秒）
pool-idle-timeout-secs = 30
# 每个主机最大空闲连接数
pool-max-idle-per-host = 8
# TCP keepalive 探测间隔（秒）
tcp-keepalive-secs = 60

