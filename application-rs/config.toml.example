name = "application-rs"

[bin-api]
port = 8080
debug = false

[databases.account]
url = "sqlite:///www/data/account.db"
max-connections = 4
min-connections = 1
acquire-timeout = 5
idle-timeout = 300

[databases.tool]
url = "sqlite:///www/data/tool.db"
min-connections = 1
max-connections = 4
idle-timeout = 300
acquire-timeout = 5

[short-url]
domain = "https://u.ysdor.cn"

[http]
connect-timeout-secs = 1
timeout-secs = 3
# 连接池空闲连接保活时长（秒）
pool-idle-timeout-secs = 30
# 每个主机最大空闲连接数
pool-max-idle-per-host = 8
# TCP keepalive 探测间隔（秒）
tcp-keepalive-secs = 60

